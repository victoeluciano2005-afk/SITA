{
  "entities": {
    "FavoriteGuide": {
      "title": "FavoriteGuide",
      "description": "A vegetable planting guide generated by Gemini and saved as a favorite by the authenticated user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Authenticated owner UID" },
        "hortalica": { "type": "string", "description": "Name of the vegetable" },
        "estado": { "type": "string", "description": "Brazilian state (UF or name)" },
        "cidade": { "type": "string", "description": "City name" },
        "mesPlantio": { "type": "string", "description": "Planned planting month" },
        "localCultivo": {
          "type": "string",
          "enum": ["Canteiro", "Vaso", "Horta vertical", "Estufa"],
          "description": "Cultivation environment"
        },
        "adequacao": {
          "type": "string",
          "enum": ["Ideal", "Possível com cuidados", "Não recomendado"],
          "description": "Suitability badge"
        },
        "vegetacaoBioma": { "type": "string", "description": "Regional biome and vegetation context" },
        "soloTipo": { "type": "string", "description": "Ideal soil type" },
        "soloPh": { "type": "string", "description": "Ideal soil pH range" },
        "soloAdubacao": { "type": "string", "description": "Recommended organic/mineral fertilization" },
        "tempMin": { "type": "string", "description": "Minimum ideal temperature" },
        "tempMax": { "type": "string", "description": "Maximum ideal temperature" },
        "luz": { "type": "string", "description": "Sunlight requirement" },
        "melhoresMeses": { "type": "string", "description": "Best planting months for the region" },
        "toleranciaClima": { "type": "string", "description": "Tolerance to rain, heat, and cold" },
        "alternativas": { "type": "string", "description": "Suggested alternatives if not ideal" },
        "irrigacaoInicio": { "type": "string", "description": "Watering guidance in initial stage" },
        "irrigacaoMeio": { "type": "string", "description": "Watering guidance in middle stage" },
        "irrigacaoFim": { "type": "string", "description": "Watering guidance in harvest stage" },
        "irrigacaoHorario": { "type": "string", "description": "Best watering time and regional climate adjustment" },
        "cicloInicioDias": { "type": "integer", "description": "Duration in days for initial stage" },
        "cicloInicioCuidados": { "type": "string", "description": "Initial stage care instructions" },
        "cicloMeioDias": { "type": "integer", "description": "Duration in days for middle stage" },
        "cicloMeioCuidados": { "type": "string", "description": "Middle stage care instructions" },
        "cicloFimDias": { "type": "integer", "description": "Duration in days for final stage" },
        "cicloFimCuidados": { "type": "string", "description": "Final stage and harvest instructions" },
        "totalDias": { "type": "integer", "description": "Total cycle duration in days" },
        "espacamento": { "type": "string", "description": "Recommended plant spacing" },
        "consorcio": { "type": "string", "description": "Companion and incompatible plants" },
        "pragas": { "type": "string", "description": "Common pests/diseases and organic control" },
        "dicas": { "type": "string", "description": "Beginner-friendly tips and EMATER note" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp (FieldValue.serverTimestamp())" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp (FieldValue.serverTimestamp())" }
      },
      "required": [
        "userId",
        "hortalica",
        "estado",
        "cidade",
        "mesPlantio",
        "localCultivo",
        "adequacao",
        "vegetacaoBioma",
        "soloTipo",
        "soloPh",
        "soloAdubacao",
        "tempMin",
        "tempMax",
        "luz",
        "melhoresMeses",
        "irrigacaoInicio",
        "irrigacaoMeio",
        "irrigacaoFim",
        "irrigacaoHorario",
        "cicloInicioDias",
        "cicloInicioCuidados",
        "cicloMeioDias",
        "cicloMeioCuidados",
        "cicloFimDias",
        "cicloFimCuidados",
        "totalDias",
        "consorcio",
        "pragas",
        "dicas",
        "createdAt",
        "updatedAt"
      ]
    },
    "GardenPlant": {
      "title": "GardenPlant",
      "description": "An active or harvested plant tracked in the user's Minha Horta with watering calendar and reminders.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Authenticated owner UID" },
        "hortalica": { "type": "string", "description": "Name of the vegetable" },
        "localCultivo": {
          "type": "string",
          "enum": ["Canteiro", "Vaso", "Horta vertical", "Estufa"],
          "description": "Cultivation environment"
        },
        "cidadeEstado": { "type": "string", "description": "City and state label" },
        "adequacao": {
          "type": "string",
          "enum": ["Ideal", "Possível com cuidados", "Não recomendado"],
          "description": "Suitability badge"
        },
        "wateringIntervalDays": { "type": "integer", "description": "Days between waterings (1 to 14)" },
        "wateringScheduleLabel": { "type": "string", "description": "Human-readable watering guidance" },
        "reminderEnabled": { "type": "boolean", "description": "Whether watering reminder is active" },
        "reminderTime": { "type": "string", "description": "Preferred watering time (HH:mm)" },
        "plantedAtEpochMillis": { "type": "integer", "description": "Planting date in epoch millis" },
        "lastWateredEpochMillis": { "type": "integer", "description": "Last watered timestamp in epoch millis (0 if never)" },
        "wateredCount": { "type": "integer", "description": "Total logged watering count" },
        "cicloInicioDias": { "type": "integer", "description": "Initial stage duration in days" },
        "cicloMeioDias": { "type": "integer", "description": "Middle stage duration in days" },
        "totalDias": { "type": "integer", "description": "Total cycle duration in days" },
        "status": {
          "type": "string",
          "enum": ["ACTIVE", "HARVESTED"],
          "description": "Lifecycle status of the garden plant"
        },
        "notes": { "type": "string", "description": "Optional user notes about this plant" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp (FieldValue.serverTimestamp())" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp (FieldValue.serverTimestamp())" }
      },
      "required": [
        "userId",
        "hortalica",
        "localCultivo",
        "cidadeEstado",
        "adequacao",
        "wateringIntervalDays",
        "wateringScheduleLabel",
        "reminderEnabled",
        "reminderTime",
        "plantedAtEpochMillis",
        "lastWateredEpochMillis",
        "wateredCount",
        "cicloInicioDias",
        "cicloMeioDias",
        "totalDias",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/favorites/{favoriteId}": {
      "schema": { "$ref": "#/entities/FavoriteGuide" },
      "description": "User's saved favorite planting guides."
    },
    "/users/{userId}/garden_plants/{plantId}": {
      "schema": { "$ref": "#/entities/GardenPlant" },
      "description": "User's active and harvested plants in Minha Horta with watering calendar and reminders."
    }
  }
}
